--- a/libavutil/mem_internal.h
+++ b/libavutil/mem_internal.h
@@ -84,6 +84,11 @@
     #define DECLARE_ALIGNED_T(n,t,v)    __declspec(align(n)) t v
     #define DECLARE_ASM_ALIGNED(n,t,v)  __declspec(align(n)) t av_used v
     #define DECLARE_ASM_CONST(n,t,v)    __declspec(align(n)) static const t av_used v
+#elif defined(__amigaos__)
+    /* Amiga hunk objects align static data to 4 bytes at most */
+    #define DECLARE_ALIGNED_T(n,t,v)    alignas(FFMIN(n, 4)) t v
+    #define DECLARE_ASM_ALIGNED(n,t,v)  alignas(FFMIN(n, 4)) t av_used v
+    #define DECLARE_ASM_CONST(n,t,v)    alignas(FFMIN(n, 4)) static const t av_used v
 #else
     #define DECLARE_ALIGNED_T(n,t,v)    alignas(n) t v
     #define DECLARE_ASM_ALIGNED(n,t,v)  alignas(n) t av_used v
